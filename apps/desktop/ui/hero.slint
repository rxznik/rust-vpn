import { LinearProgressIndicator, MaterialPalette } from "@material";
import { NameLine, NameRun } from "server_card.slint";
import { AppTheme } from "theme.slint";

export component Hero inherits Rectangle {
    in property <int> phase;
    in property <bool> disconnecting;
    in property <string> status-text;
    in property <string> selected-name;
    in property <string> selected-id;
    in property <string> live-id;
    in property <string> up-text;
    in property <string> down-text;
    in property <string> traffic-text;
    in property <string> announce-text;
    in property <float> bar;
    in property <float> power-pulse: 1;
    in property <bool> flowing: false;
    in property <float> flow: 0;
    in property <bool> motion: true;
    in property <[NameRun]> title-runs;
    in property <[NameRun]> next-runs;
    callback activate();

    background: MaterialPalette.surface-container;
    border-radius: 16px;
    border-width: AppTheme.frosted ? 1px : 0px;
    border-color: AppTheme.rim;
    clip: true;

    if root.flowing: Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        for line in 5: Path {
            property <float> drift: mod(root.flow + line * 0.2, 1);
            x: -240px * self.drift;
            y: parent.height * (0.08 + line * 0.2) - 18px;
            width: parent.width + 240px;
            height: 40px;
            stroke: MaterialPalette.primary;
            stroke-width: 1.5px;
            opacity: 0.16 + line * 0.04;
            fill: transparent;
            commands: "M 0 20 C 40 2, 80 2, 120 20 C 160 38, 200 38, 240 20 C 280 2, 320 2, 360 20 C 400 38, 440 38, 480 20 C 520 2, 560 2, 600 20 C 640 38, 680 38, 720 20 C 760 2, 800 2, 840 20 C 880 38, 920 38, 960 20 C 1000 2, 1040 2, 1080 20 C 1120 38, 1160 38, 1200 20 C 1240 2, 1280 2, 1320 20 C 1360 38, 1400 38, 1440 20";
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 16px;
            cross-axis-alignment: center;

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                alignment: start;

                Text {
                    text: "Выбранный узел";
                    color: MaterialPalette.on-surface-variant;
                    font-size: 1rem;
                }

                if root.title-runs.length == 0: Text {
                    text: "Сервер не выбран";
                    color: MaterialPalette.on-surface;
                    font-size: (22px / 12px) * 1rem;
                    font-weight: 700;
                    overflow: elide;
                }

                if root.title-runs.length > 0: NameLine {
                    runs: root.title-runs;
                    color: MaterialPalette.on-surface;
                    mark-size: (22px / 12px) * 1rem;
                    text-size: (22px / 12px) * 1rem;
                    text-weight: 700;
                }

                Text {
                    text: root.status-text;
                    color: root.phase == 3 ? MaterialPalette.error : root.phase == 2 ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    font-size: (13px / 12px) * 1rem;
                    overflow: elide;
                }

                if root.phase == 2 && root.selected-id != root.live-id && root.selected-name != "": HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Text {
                        text: "Дальше подключится";
                        color: MaterialPalette.on-surface-variant;
                        font-size: 1rem;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                    }

                    NameLine {
                        runs: root.next-runs;
                        color: MaterialPalette.on-surface-variant;
                        mark-size: (14px / 12px) * 1rem;
                        text-size: 1rem;
                        text-weight: 400;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: 12px;
                        background: MaterialPalette.surface-container-highest;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: "↑ " + root.up-text;
                                color: MaterialPalette.on-surface;
                                font-size: 1rem;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: 12px;
                        background: MaterialPalette.surface-container-highest;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: "↓ " + root.down-text;
                                color: MaterialPalette.on-surface;
                                font-size: 1rem;
                            }
                        }
                    }
                }

                if root.traffic-text != "": Text {
                    text: root.traffic-text;
                    color: MaterialPalette.on-surface-variant;
                    font-size: 1rem;
                    overflow: elide;
                }

                if root.announce-text != "": Text {
                    text: root.announce-text;
                    color: MaterialPalette.on-surface;
                    font-size: 1rem;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                width: 124px;
                height: 124px;
                horizontal-stretch: 0;
                vertical-stretch: 0;

                Rectangle {
                    width: 84px + 40px * root.power-pulse;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: root.phase == 3 ? MaterialPalette.error : MaterialPalette.primary;
                    opacity: root.power-pulse * 0.45;
                }

                Rectangle {
                    width: 84px + 18px * root.power-pulse;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: root.phase == 3 ? MaterialPalette.error : MaterialPalette.primary;
                    opacity: root.power-pulse * 0.85;
                }

                power := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 84px;
                    height: 84px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    border-radius: 42px;
                    background: root.phase == 3 ? MaterialPalette.error : root.phase == 0 ? MaterialPalette.surface-container-highest : MaterialPalette.primary;
                    transform-scale: 1;
                    animate transform-scale {
                        duration: root.motion ? 300ms : 0ms;
                        easing: ease-in-out;
                    }

                    Path {
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: root.phase == 0 ? MaterialPalette.on-surface : MaterialPalette.on-primary;
                        stroke-width: 1.75px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        fill: transparent;
                        commands: "M12 2v10M18.36 6.64a9 9 0 1 1-12.72 0";
                    }

                    power-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Подключение";
                        clicked => {
                            root.activate();
                        }
                    }
                }
            }
        }

        if root.phase != 0 || root.disconnecting: LinearProgressIndicator {
            progress: root.bar;
            indeterminate: root.phase == 1 || root.disconnecting;
        }
    }

    states [
        raised when root.motion && power-touch.has-hover: {
            power.transform-scale: 1.075;
        }
    ]
}
